# -----------------------------------------------------------------------
# This file holds SECRET values and must be encrypted with ansible-vault
# before it's committed to git. Never commit the plaintext version.
#
# Steps:
#   1. cp vault.yml.example vault.yml
#   2. Edit vault.yml and replace the CHANGEME placeholders with real values
#   3. ansible-vault encrypt vault.yml
#   4. git add vault.yml   (the encrypted version is safe to commit)
#
# In AWX, create a "Vault" credential type with the same vault password
# and attach it to any Job Template that uses this file (the config /
# install-nginx Job Template). AWX will decrypt it at runtime — you never
# type the vault password again after that.
# -----------------------------------------------------------------------

vault_webserver_admin_password: "CHANGEME"
enable_basic_auth: false   # flip to true once vault_webserver_admin_password is real
